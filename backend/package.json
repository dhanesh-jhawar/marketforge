{
  "name": "@marketforge/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "start": "node --env-file-if-exists=../.env src/server.js",
    "worker:market": "node --env-file-if-exists=../.env src/workers/marketSync.worker.js",
