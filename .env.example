# =====================================================================
# MarketForge environment variables
# Copy to `.env` (backend/root) and `frontend/.env.local` (NEXT_PUBLIC_* only).
# NEVER expose provider secrets to the frontend. The frontend only talks
# to the MarketForge backend.
# =====================================================================

# ---------- General ----------
NODE_ENV=development
APP_NAME=MarketForge
LOG_LEVEL=info

# ---------- Backend ----------
BACKEND_PORT=4000
BACKEND_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
# sqlite | memory | postgres
DATA_STORE=sqlite
# SQLite database file path (relative to project root or absolute)
SQLITE_PATH=database/marketforge.db
# Dev-only JWT (used when AUTH_PROVIDER=local)
JWT_SECRET=change-me-dev-only
JWT_EXPIRES_IN=7d

# ---------- Frontend (safe to expose) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
# When true, frontend uses /data/demo fixtures if the backend is unreachable
NEXT_PUBLIC_USE_DEMO_FALLBACK=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- Optional External Database (if DATA_STORE=postgres) ----------
# DATABASE_URL=postgres://marketforge:marketforge@localhost:5432/marketforge
DATABASE_SSL=false

# ---------- Auth ----------
# local | supabase
AUTH_PROVIDER=local
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ---------- Market data provider selection ----------
# Ordered fallback chain. Options: mock | fyers | tejhq | twelvedata
MARKET_DATA_PROVIDERS=mock
HISTORICAL_DATA_PROVIDERS=mock
REALTIME_PROVIDER=mock
QUOTE_CACHE_TTL_MS=2000
HISTORY_CACHE_TTL_MS=300000

# ---------- TejHQ (Indian market data) ----------
TEJHQ_API_KEY=
TEJHQ_BASE_URL=

# ---------- FYERS (historical + live + WebSocket) ----------
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=http://localhost:4000/api/admin/sync/fyers/callback
FYERS_ACCESS_TOKEN=
FYERS_BASE_URL=https://api-t1.fyers.in/api/v3
FYERS_DATA_URL=https://api-t1.fyers.in/data

# ---------- Twelve Data (backup / global) ----------
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

# ---------- News ----------
# Ordered fallback chain. Options: mock | gnews | newsapi
NEWS_PROVIDERS=mock
GNEWS_API_KEY=
GNEWS_BASE_URL=https://gnews.io/api/v4
NEWSAPI_KEY=
NEWSAPI_BASE_URL=https://newsapi.org/v2

# ---------- AI (Google Gemini) ----------
# mock | gemini
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---------- NSE security master ----------
NSE_EQUITY_LIST_URL=https://nsearchives.nseindia.com/content/equities/EQUITY_L.csv
# Local fallback used in development / when NSE blocks automated requests
NSE_SECURITY_MASTER_FALLBACK=database/seeds/securities.sample.csv

# ---------- Workers ----------
WORKERS_ENABLED=true
MARKET_SYNC_INTERVAL_MS=5000
NEWS_SYNC_INTERVAL_MS=600000
SECURITY_MASTER_SYNC_CRON=0 6 * * *

# ---------- Virtual trading defaults ----------
DEFAULT_VIRTUAL_CAPITAL=1000000
SIMULATED_SLIPPAGE_BPS=5
BROKERAGE_FLAT_PER_ORDER=20
